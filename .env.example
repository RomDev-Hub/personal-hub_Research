# Telegram Bot — tạo tại @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Chat ID — lấy sau khi nhắn /start cho bot, mở getUpdates
TELEGRAM_CHAT_ID=123456789

# Tùy chọn — bảo vệ API /api/hub/tick (worker gửi header x-hub-secret)
# HUB_CRON_SECRET=your-secret-here

# Tab Telegram — làm mới trạng thái/ghi nhật ký chỉ trong UI (ms). Không nhân đôi với hub-worker khi chỉ có biến này (mặc định 60000).
# NEXT_PUBLIC_TELEGRAM_UI_REFRESH_MS=60000
# CHỈ khi chạy KHÔNG có hub-worker — bật gọi /api/hub/tick + poll từ trình duyệt (ms, > 0). Mặc định = 0 (để worker xử lý).
# NEXT_PUBLIC_HUB_CLIENT_TICK_MS=45000

# Thị trường — poll UI (ms). Mặc định 30000 = 30 giây
NEXT_PUBLIC_MARKET_POLL_MS=30000
# Ghi điểm lịch sử tự động (ms). Mặc định 60000 = 1 phút
# MARKET_RECORD_MS=60000
# Cache server: giá VN (ms), metals/forex (ms), biểu đồ (ms)
# MARKET_VN_TTL_MS=3000
# MARKET_METALS_TTL_MS=30000
# MARKET_CHART_TTL_MS=30000
